# ==========================================
# Wall-E-Replica 项目专属 .gitignore
# 工具链: ESP-IDF, 立创EDA, Fusion 360
# ==========================================

# 1. ESP-IDF 编译产物与缓存
03-Software/Walle26/build/
03-Software/Walle26/managed_components/
03-Software/Walle26/dependencies.lock
*.bin
*.elf
*.map
*.hex
sdkconfig.old

# 2. 立创EDA (EasyEDA) 自动备份与系统缓存
02-Hardware/**/*.bak
02-Hardware/**/*.lck
02-Hardware/Recovery/
02-Hardware/History/

# 3. Fusion 360 本地缓存与备份
04-Mechanical/**/*.f3d.bak
04-Mechanical/**/*.f3d.tmp

# 4. 大型媒体资源 (不纳入Git跟踪)
05-Assets/**/*.wav
05-Assets/**/*.mp4
05-Assets/**/*.avi
05-Assets/**/*.mov

# 5. 操作系统缓存
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# 6. 编辑器与 IDE 配置文件 (VS Code 等)
.vscode/
.idea/

# 7. 通用临时文件
*.log
*.tmp
*.bak
*.swp
*~

# 8. Microsoft Office 临时文件与锁定文件
~$*.doc*
~$*.xls*
~$*.ppt*
~*.tmp
*.tmp

# 9. Claude 缓存
.claude/

# 10. 论文参考资料与机械设计源文件 (外部引用，不纳入跟踪)
06-Thesis/
04-Mechanical/**/*.stp
04-Mechanical/**/*.step
